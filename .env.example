# FreshiNotei 백엔드 로컬 실행용 환경변수 예시
#
# 1) 이 파일을 복사:  cp .env.example .env
# 2) .env 에 실제 값 입력 (.env 는 .gitignore 에 포함되어 커밋되지 않음)
# 3) 환경변수로 불러온 뒤 실행:
#      set -a; source .env; set +a
#      mvn spring-boot:run
#    (IntelliJ 는 Run Configuration → Environment variables 에 같은 값 입력)
#
# ⚠️ 실제 키는 절대 이 파일에 쓰지 마세요. 이 파일은 공개 레포에 올라갑니다.

# [필수] Google AI Studio 에서 발급한 Gemini API 키
GEMINI_API_KEY=

# [선택] 사용할 Gemini 모델 (기본값: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# [선택] 서버 포트 (기본값: 8080)
PORT=8080
