[Unit]
Description=FreshiNotei Backend (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
User=freshi
WorkingDirectory=/opt/freshinotei
EnvironmentFile=/etc/freshinotei.env
ExecStart=/bin/sh -c 'exec /usr/bin/java $JAVA_OPTS -jar /opt/freshinotei/app.jar'
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
