# FreshiNotei 백엔드 — Lightsail 서버용 환경변수 템플릿
#
# setup.sh 가 이 파일을 /etc/freshinotei.env 로 복사합니다 (권한 600, root 전용).
# 서버에서 값 수정:  sudo nano /etc/freshinotei.env
# 수정 후 반영:      sudo systemctl restart freshinotei
#
# ⚠️ 실제 키는 이 파일(레포)에 쓰지 말고 서버의 /etc/freshinotei.env 에만 입력하세요.

# [필수] Gemini API 키
GEMINI_API_KEY=여기에_API_키_입력

# [선택] 모델 교체 시 주석 해제
# GEMINI_MODEL=gemini-3.1-flash-lite

# 외부에서 8080 으로 직접 접근하지 못하게 localhost 에만 바인딩 (Caddy 가 앞단에서 받음)
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# 2GB 인스턴스 기준 JVM 메모리
JAVA_OPTS=-Xms256m -Xmx1g
